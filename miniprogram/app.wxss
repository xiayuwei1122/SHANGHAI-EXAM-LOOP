page {
  --paper: #fffdf8;
  --canvas: #f6f1e8;
  --ink: #29231f;
  --muted: #786d64;
  --line: #dfd4c7;
  --red: #a64132;
  --red-dark: #783026;
  --gold: #d5a03f;
  --green: #48745b;
  --blue: #496f88;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.card { background: var(--paper); border: 1rpx solid var(--line); border-radius: 28rpx; box-shadow: 0 14rpx 34rpx rgba(72, 53, 39, .08); }
.btn { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 0 26rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; line-height: 1; background: white; border: 1rpx solid var(--line); }
.btn::after { border: 0; }
.btn-primary { background: var(--red); color: white; border-color: var(--red); }
.btn-ghost { background: transparent; color: var(--red-dark); border-color: #cba69f; }
.pill { display: inline-flex; align-items: center; padding: 8rpx 15rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; color: #65574d; background: #eee6dc; }
.muted { color: var(--muted); }
.section-title { margin: 38rpx 0 18rpx; font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; }
