.methods-page { padding-bottom: 60rpx; }
.methods-hero { padding: 34rpx; color: #fffaf2; background: linear-gradient(145deg, #2f3530, #3f5145); }
.methods-eyebrow { color: #e7c76f; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.methods-title { max-width: 590rpx; margin-top: 20rpx; font-family: "Songti SC", serif; font-size: 43rpx; font-weight: 800; line-height: 1.4; }
.methods-note { margin-top: 15rpx; color: #d5ded7; font-size: 24rpx; line-height: 1.7; }
.methods-actions { display: grid; grid-template-columns: 1.25fr 1fr; gap: 14rpx; margin-top: 28rpx; }
.methods-actions .btn { margin: 0; }
.photo-button { color: #f9f3e8; border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.09); }
.method-toolbar { display: flex; align-items: center; gap: 16rpx; margin-top: 30rpx; }
.search-input { flex: 1; height: 76rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--paper); font-size: 25rpx; }
.method-count { flex: none; color: var(--muted); font-size: 22rpx; }
.category-scroll { margin: 18rpx 0 22rpx; white-space: nowrap; }
.category-list { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.category-chip { flex: none; padding: 12rpx 20rpx; border-radius: 999rpx; color: var(--muted); background: #eae1d6; font-size: 22rpx; }
.category-chip.active { color: white; background: var(--red); }
.method-list { display: flex; flex-direction: column; gap: 18rpx; }
.method-card { padding: 27rpx; }
.method-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.category-label { padding: 7rpx 13rpx; border-radius: 10rpx; color: var(--green); background: #e5efe8; font-size: 20rpx; font-weight: 800; }
.method-date { color: #9a8e84; font-size: 20rpx; }
.method-name { margin-top: 17rpx; font-size: 30rpx; font-weight: 800; }
.method-summary { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.65; }
.method-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 15rpx; }
.method-tags text { color: var(--blue); font-size: 21rpx; }
.method-meta { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; padding-top: 17rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 21rpx; }
.method-meta label { margin-left: auto; color: var(--red); font-weight: 700; }
.method-empty { margin-top: 26rpx; padding: 54rpx 28rpx; text-align: center; }
.empty-icon { font-size: 56rpx; }
.empty-title { margin-top: 15rpx; font-size: 29rpx; font-weight: 800; }
.empty-note { max-width: 520rpx; margin: 10rpx auto 0; color: var(--muted); font-size: 23rpx; line-height: 1.7; }
.local-note { margin: 30rpx 16rpx 0; color: var(--muted); font-size: 21rpx; line-height: 1.7; text-align: center; }
