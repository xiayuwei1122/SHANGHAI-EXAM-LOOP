.methods-page { min-height: 100vh; padding-bottom: 60rpx; background: #f7f8ff; }
.methods-page .card { border-color: #e7e8f4; background: #fff; box-shadow: 0 14rpx 38rpx rgba(75,72,140,.08); }
.methods-hero { position: relative; overflow: hidden; padding: 36rpx; color: white; border: 0 !important; background: linear-gradient(145deg, #29283f, #454069 68%, #665785) !important; box-shadow: 0 22rpx 48rpx rgba(45,43,91,.22) !important; }
.methods-hero::after { content: ""; position: absolute; right: -65rpx; top: -80rpx; width: 240rpx; height: 240rpx; border-radius: 50%; background: rgba(255,255,255,.12); }
.methods-corn { position: absolute; z-index: 2; right: 28rpx; top: 22rpx; font-size: 68rpx; transform: rotate(8deg); filter: drop-shadow(0 8rpx 12rpx rgba(0,0,0,.15)); }
.methods-eyebrow { color: #ffe17d; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.methods-title { position: relative; z-index: 1; max-width: 590rpx; margin-top: 20rpx; font-size: 43rpx; font-weight: 800; line-height: 1.4; }
.methods-note { position: relative; z-index: 1; margin-top: 15rpx; color: rgba(255,255,255,.84); font-size: 24rpx; line-height: 1.7; }
.methods-actions { position: relative; z-index: 1; display: grid; grid-template-columns: 1.25fr 1fr; gap: 14rpx; margin-top: 28rpx; }
.methods-actions .btn { margin: 0; }
.methods-actions .btn-primary { color: #625ce0; border-color: white; background: white; box-shadow: 0 9rpx 22rpx rgba(54,47,130,.14); }
.template-button { color: white; border-color: rgba(255,255,255,.35); background: rgba(255,255,255,.14); }
.method-toolbar { display: flex; align-items: center; gap: 16rpx; margin-top: 30rpx; }
.search-input { flex: 1; height: 76rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #e1e3f1; border-radius: 20rpx; background: white; box-shadow: 0 8rpx 24rpx rgba(70,72,120,.05); font-size: 25rpx; }
.method-count { flex: none; color: #77778d; font-size: 22rpx; }
.category-scroll { margin: 18rpx 0 22rpx; white-space: nowrap; }
.category-list { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.category-chip { flex: none; padding: 12rpx 20rpx; border-radius: 999rpx; color: #67677c; background: #eceeff; font-size: 22rpx; }
.category-chip.active { color: white; background: #6964e8; box-shadow: 0 7rpx 18rpx rgba(105,100,232,.24); }
.method-list { display: flex; flex-direction: column; gap: 18rpx; }
.method-loading { display: flex; flex-direction: column; gap: 18rpx; }
.loading-card { padding: 30rpx; border: 1rpx solid #e7e8f4; border-radius: 22rpx; background: white; }
.loading-line { width: 72%; height: 24rpx; margin-top: 20rpx; border-radius: 999rpx; background: #eff0f7; }
.loading-line:first-child { margin-top: 0; }
.loading-line.wide { width: 46%; height: 30rpx; background: #e8e7fb; }
.loading-line.short { width: 32%; }
.method-card { position: relative; overflow: hidden; padding: 28rpx; }
.method-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 7rpx; background: #ff91bd; }
.method-card.structured::before { background: #5bc8a5; }
.method-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.method-head > view:first-child { display: flex; align-items: center; gap: 9rpx; }
.kind-label, .category-label { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; }
.kind-label { color: #655fe1; background: #eeedff; }
.kind-label.structured { color: #178467; background: #e6f8f1; }
.category-label { color: #79798c; background: #f3f3f8; }
.method-date { color: #a0a0af; font-size: 20rpx; }
.method-name { margin-top: 18rpx; color: #292940; font-size: 30rpx; font-weight: 800; }
.method-summary { margin-top: 10rpx; color: #717184; font-size: 24rpx; line-height: 1.65; }
.method-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 15rpx; }
.method-tags text { color: #625ce0; font-size: 21rpx; }
.method-meta { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; padding-top: 17rpx; border-top: 1rpx solid #ececf3; color: #868697; font-size: 21rpx; }
.delete-entry { min-height: 44rpx; margin: 0 0 0 auto; padding: 0 15rpx; border-radius: 999rpx; color: #d94f72; background: #fff1f5; font-size: 20rpx; line-height: 44rpx; }
.delete-entry::after { border: 0; }
.method-meta label { color: #625ce0; font-weight: 700; }
.method-empty { margin-top: 26rpx; padding: 54rpx 28rpx; text-align: center; }
.empty-icon { display: grid; place-items: center; width: 84rpx; height: 84rpx; margin: 0 auto; border-radius: 28rpx; color: white; background: linear-gradient(135deg, #7770ee, #f185b7); font-size: 50rpx; transform: rotate(-4deg); }
.empty-title { margin-top: 20rpx; color: #292940; font-size: 29rpx; font-weight: 800; }
.empty-note { max-width: 520rpx; margin: 10rpx auto 0; color: #77778a; font-size: 23rpx; line-height: 1.7; }
.pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18rpx; margin-top: 28rpx; }
.page-button { min-height: 66rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid #dfe1f0; border-radius: 18rpx; color: #625ce0; background: white; font-size: 23rpx; font-weight: 700; line-height: 66rpx; }
.page-button::after { border: 0; }
.page-button[disabled] { color: #b4b4c2; background: #eff0f6; opacity: .75; }
.page-status { min-width: 105rpx; color: #8b8b9c; text-align: center; }
.page-status text { color: #625ce0; font-size: 30rpx; font-weight: 800; }
.page-status label { margin-left: 6rpx; font-size: 21rpx; }
.local-note { margin: 30rpx 16rpx 0; color: #858596; font-size: 21rpx; line-height: 1.7; text-align: center; }
