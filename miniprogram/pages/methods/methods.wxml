<view class="page methods-page">
  <view class="methods-hero card">
    <view class="methods-eyebrow">我的灵感本</view>
    <view class="methods-title">不必照格式，按自己的方式记。</view>
    <view class="methods-note">手写、圈画、加文字、贴题目图片。想认真整理时，也可以使用方法卡模板。</view>
    <view class="methods-actions">
      <button class="btn btn-primary" bindtap="createFreeNote">✎ 自由笔记</button>
      <button class="btn template-button" bindtap="createMethod">方法卡模板</button>
    </view>
  </view>

  <view class="method-toolbar">
    <input class="search-input" value="{{keyword}}" bindinput="search" placeholder="搜索标题、分类或笔记文字" />
    <view class="method-count">{{entryCount}} 篇</view>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" enable-flex="true" wx:if="{{categories.length}}">
    <view class="category-list">
      <view class="category-chip {{selectedCategory === item.name ? 'active' : ''}}" wx:for="{{categories}}" wx:key="name" data-name="{{item.name}}" bindtap="selectCategory">{{item.name}} · {{item.count}}</view>
    </view>
  </scroll-view>

  <view class="method-empty card" wx:if="{{!items.length}}">
    <view class="empty-icon">✎</view>
    <view class="empty-title">{{entryCount ? '没有匹配的内容' : '先写下第一张自由笔记吧'}}</view>
    <view class="empty-note">{{entryCount ? '换个分类或关键词看看。' : '不需要想好格式，先写、先画，之后再慢慢整理。'}}</view>
  </view>

  <view class="method-list" wx:else>
    <view class="method-card card {{item.kind}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editItem">
      <view class="method-head"><view><text class="kind-label {{item.kind}}">{{item.kindLabel}}</text><text class="category-label">{{item.category}}</text></view><view class="method-date">{{item.dateText}}</view></view>
      <view class="method-name">{{item.title}}</view>
      <view class="method-summary">{{item.summary}}</view>
      <view class="method-tags" wx:if="{{item.tags && item.tags.length}}"><text wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text></view>
      <view class="method-meta" wx:if="{{item.kind === 'free'}}"><text>笔画 {{item.strokeCount}}</text><text>图片 {{item.imageCount}}</text><label>继续创作 ›</label></view>
      <view class="method-meta" wx:else><text>典型题 {{item.exampleCount}}</text><text>图片 {{item.imageCount}}</text><label>查看编辑 ›</label></view>
    </view>
  </view>

  <view class="local-note">当前笔记只保存在本机，不会上传。清理微信数据或更换设备前请注意备份。</view>
</view>
