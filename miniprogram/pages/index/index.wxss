.home-page { min-height: 100vh; padding-bottom: 70rpx; background: #f7f8ff; }
.hero { position: relative; overflow: hidden; padding: 38rpx; color: white; border: 0; background: linear-gradient(145deg, #29283f, #454069 68%, #665785); box-shadow: 0 22rpx 48rpx rgba(45,43,91,.22); }
.hero::after { content: ""; position: absolute; right: -80rpx; top: -95rpx; width: 270rpx; height: 270rpx; border-radius: 50%; background: rgba(255,255,255,.06); }
.corn { position: absolute; z-index: 2; right: 28rpx; top: 22rpx; font-size: 68rpx; transform: rotate(8deg); filter: drop-shadow(0 8rpx 12rpx rgba(0,0,0,.15)); }
.eyebrow { color: #ffe17d; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.hero-title { position: relative; z-index: 1; margin-top: 26rpx; max-width: 560rpx; font-size: 51rpx; line-height: 1.35; font-weight: 800; }
.hero-note { position: relative; z-index: 1; margin-top: 20rpx; max-width: 590rpx; color: rgba(255,255,255,.78); font-size: 26rpx; line-height: 1.7; }
.stats { position: relative; z-index: 1; display: flex; gap: 12rpx; margin-top: 34rpx; }
.stat { flex: 1; padding: 20rpx 12rpx; text-align: center; border: 1rpx solid rgba(255,255,255,.08); border-radius: 20rpx; background: rgba(255,255,255,.09); }
.stat text { display: block; color: #ffe17d; font-size: 39rpx; font-weight: 800; }
.stat label { display: block; margin-top: 5rpx; color: rgba(255,255,255,.7); font-size: 21rpx; }
.hero-actions { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; margin-top: 22rpx; }
.hero-link { margin: 0; color: white; border-color: rgba(255,255,255,.24); background: rgba(255,255,255,.1); }
.method-link { color: #ffe17d; }
.paper-section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: #292940; }
.paper-section-title label { color: var(--muted); font-size: 22rpx; font-weight: 600; }
.filter-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.exam-picker, .year-picker { min-width: 0; }
.filter-control { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10rpx; min-height: 76rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #e1e3f0; border-radius: 20rpx; color: var(--red-dark); background: white; box-shadow: 0 8rpx 22rpx rgba(73,73,130,.05); }
.filter-control label { color: var(--muted); font-size: 20rpx; font-weight: 500; }
.filter-control text { overflow: hidden; font-size: 25rpx; font-weight: 800; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.filter-control small { color: var(--muted); font-size: 21rpx; }
.filter-caption { margin: 12rpx 2rpx 20rpx; color: var(--muted); font-size: 22rpx; font-weight: 600; text-align: right; }
.empty-state { padding: 48rpx 32rpx; text-align: center; }
.empty-icon { font-size: 58rpx; }
.empty-title { margin-top: 16rpx; font-size: 30rpx; font-weight: 800; }
.empty-text { max-width: 520rpx; margin: 12rpx auto 0; color: var(--muted); font-size: 24rpx; line-height: 1.7; }
.paper-list { display: flex; flex-direction: column; gap: 20rpx; }
.paper-card { padding: 28rpx; border-color: #e5e6f0; background: white; }
.paper-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.paper-year { color: #6964e8; font-size: 43rpx; font-weight: 800; }
.paper-name { margin-top: 4rpx; color: #292940; font-size: 29rpx; font-weight: 800; }
.paper-meta { margin-top: 17rpx; color: var(--muted); font-size: 24rpx; }
.paper-draft { margin-top: 10rpx; color: var(--blue); font-size: 23rpx; font-weight: 700; }
.paper-best { margin-top: 9rpx; color: var(--green); font-size: 24rpx; font-weight: 700; }
.paper-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; margin-top: 23rpx; }
.pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18rpx; margin-top: 28rpx; }
.page-button { min-height: 68rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid #dfe1ef; border-radius: 18rpx; color: var(--red-dark); background: white; font-size: 24rpx; font-weight: 700; line-height: 68rpx; }
.page-button::after { border: 0; }
.page-button[disabled] { color: #b4b4c2; background: #eff0f6; opacity: .75; }
.page-status { min-width: 108rpx; color: var(--muted); text-align: center; }
.page-status text { color: var(--red); font-size: 31rpx; font-weight: 800; }
.page-status label { margin-left: 7rpx; font-size: 22rpx; }
.source-note { margin: 32rpx 18rpx 0; color: var(--muted); font-size: 22rpx; line-height: 1.7; text-align: center; }
.mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; background: rgba(35,34,58,.48); }
.sheet { width: 100%; max-height: 80vh; padding: 20rpx 30rpx 42rpx; box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: white; overflow: auto; }
.sheet-handle { width: 74rpx; height: 8rpx; margin: 0 auto 26rpx; border-radius: 999rpx; background: #d9daea; }
.sheet-title { color: #292940; font-size: 34rpx; font-weight: 800; }
.sheet-subtitle { margin: 7rpx 0 22rpx; color: var(--muted); font-size: 24rpx; }
.module-row { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 94rpx; padding: 0 22rpx; border-radius: 18rpx; background: #f3f4fb; font-size: 28rpx; text-align: left; margin-bottom: 12rpx; }
.module-row::after { border: 0; }
.module-row label { color: var(--muted); font-size: 24rpx; }
.module-row label.has-draft { color: var(--blue); font-weight: 700; }
.close-btn { margin-top: 20rpx; }
