.home-page { padding-bottom: 70rpx; }
.hero { padding: 38rpx; background: linear-gradient(145deg, #302a26, #43372f); color: #fffaf2; overflow: hidden; position: relative; }
.corn { position: absolute; right: 28rpx; top: 22rpx; font-size: 68rpx; transform: rotate(8deg); }
.eyebrow { color: #e8bd63; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.hero-title { margin-top: 26rpx; font-family: "Songti SC", serif; font-size: 51rpx; line-height: 1.35; font-weight: 700; }
.hero-note { margin-top: 20rpx; max-width: 590rpx; color: #d8cdc3; font-size: 26rpx; line-height: 1.7; }
.stats { display: flex; gap: 12rpx; margin-top: 34rpx; }
.stat { flex: 1; padding: 20rpx 12rpx; text-align: center; border-radius: 20rpx; background: rgba(255,255,255,.08); }
.stat text { display: block; font-size: 39rpx; color: #f0c76e; font-weight: 800; }
.stat label { display: block; margin-top: 5rpx; color: #cfc4ba; font-size: 21rpx; }
.history-btn { margin-top: 22rpx; color: #fff; background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.2); }
.paper-section-title { display: flex; align-items: baseline; justify-content: space-between; }
.paper-section-title label { color: var(--muted); font-size: 22rpx; font-weight: 500; }
.year-scroll { margin-bottom: 20rpx; white-space: nowrap; }
.year-filter { display: inline-flex; gap: 12rpx; padding: 2rpx 2rpx 8rpx; }
.year-chip { display: inline-flex; align-items: center; gap: 9rpx; min-width: 104rpx; height: 62rpx; margin: 0; padding: 0 20rpx; border: 2rpx solid var(--line); border-radius: 999rpx; color: var(--muted); background: #fffaf2; font-size: 25rpx; font-weight: 700; line-height: 58rpx; }
.year-chip::after { border: 0; }
.year-chip label { display: grid; place-items: center; min-width: 29rpx; height: 29rpx; padding: 0 7rpx; border-radius: 999rpx; color: #8b7869; background: #eee4d8; font-size: 18rpx; line-height: 1; }
.year-chip.active { color: white; border-color: var(--red); background: var(--red); }
.year-chip.active label { color: var(--red-dark); background: #f5dca8; }
.paper-list { display: flex; flex-direction: column; gap: 20rpx; }
.paper-card { padding: 28rpx; }
.paper-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.paper-year { color: var(--red); font-family: Georgia, serif; font-size: 43rpx; font-weight: 800; }
.paper-name { margin-top: 4rpx; font-size: 29rpx; font-weight: 700; }
.pill.validation { color: var(--red-dark); background: #f3dfdc; }
.paper-meta { margin-top: 17rpx; color: var(--muted); font-size: 24rpx; }
.paper-best { margin-top: 9rpx; color: var(--green); font-size: 24rpx; font-weight: 700; }
.paper-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; margin-top: 23rpx; }
.source-note { margin: 32rpx 18rpx 0; color: var(--muted); font-size: 22rpx; line-height: 1.7; text-align: center; }
.mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; background: rgba(27,23,20,.48); }
.sheet { width: 100%; max-height: 80vh; padding: 20rpx 30rpx 42rpx; box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: var(--paper); overflow: auto; }
.sheet-handle { width: 74rpx; height: 8rpx; margin: 0 auto 26rpx; border-radius: 999rpx; background: #d4c8bb; }
.sheet-title { font-size: 34rpx; font-weight: 800; }
.sheet-subtitle { margin: 7rpx 0 22rpx; color: var(--muted); font-size: 24rpx; }
.module-row { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 94rpx; padding: 0 22rpx; border-radius: 18rpx; background: #f7f1e9; font-size: 28rpx; text-align: left; margin-bottom: 12rpx; }
.module-row::after { border: 0; }
.module-row label { color: var(--muted); font-size: 24rpx; }
.close-btn { margin-top: 20rpx; }
