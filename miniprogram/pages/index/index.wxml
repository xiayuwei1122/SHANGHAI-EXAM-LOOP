<view class="page home-page">
  <view class="hero card">
    <view class="corn">🌽</view>
    <view class="eyebrow">上岸刷题簿</view>
    <view class="hero-title">把一套题刷透，<br/>比盲目追新题更重要。</view>
    <view class="hero-note">整卷检验节奏，模块拆解能力。蒙对的题，也会被单独捞出来复盘。</view>
    <view class="stats">
      <view class="stat"><text>{{attemptCount}}</text><label>完成轮次</label></view>
      <view class="stat"><text>{{bestScore}}</text><label>历史最好</label></view>
      <view class="stat"><text>{{totalPaperCount}}</text><label>回忆版试卷</label></view>
    </view>
    <button class="btn history-btn" bindtap="openHistory">查看练习记录</button>
  </view>

  <view class="section-title paper-section-title" id="paper-section">
    <text>选择试卷</text><label>{{paperCount}} 套</label>
  </view>
  <view class="filter-row">
    <picker class="exam-picker" mode="selector" range="{{examTypes}}" range-key="label" value="{{selectedExamTypeIndex}}" bindchange="selectExamType">
      <view class="filter-control">
        <label>考试类型</label><text>{{selectedExamTypeLabel}}</text><small>⌄</small>
      </view>
    </picker>
    <picker class="year-picker" mode="selector" range="{{years}}" range-key="label" value="{{selectedYearIndex}}" bindchange="selectYear">
      <view class="filter-control">
        <label>年份</label><text>{{selectedYearLabel}}</text><small>⌄</small>
      </view>
    </picker>
  </view>
  <view class="filter-caption">{{filterHint}}</view>
  <view class="empty-state card" wx:if="{{!papers.length}}">
    <view class="empty-icon">🗂️</view>
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-text">{{emptyText}}</view>
  </view>
  <view class="paper-list" wx:else>
    <view class="paper-card card" wx:for="{{papers}}" wx:key="id">
      <view class="paper-head">
        <view>
          <view class="paper-year">{{item.year}}</view>
          <view class="paper-name">{{item.displayTitle}}</view>
        </view>
        <view class="pill {{item.year >= 2025 ? 'validation' : ''}}">{{item.year >= 2025 ? '阶段验收' : '方法训练'}}</view>
      </view>
      <view class="paper-meta">{{item.questionCount}} 题 · {{item.answerCount}} 题可评分 · 已刷 {{item.attemptCount}} 次</view>
      <view class="paper-best" wx:if="{{item.bestScore !== null}}">历史最好：{{item.bestScore}} 分</view>
      <view class="paper-actions">
        <button class="btn btn-primary" data-paper="{{item.id}}" bindtap="startPaper">刷整卷</button>
        <button class="btn btn-ghost" data-paper="{{item.id}}" bindtap="chooseModule">选模块</button>
      </view>
    </view>
  </view>

  <view class="pagination" wx:if="{{hasPagination}}">
    <button class="page-button" disabled="{{currentPage <= 1}}" bindtap="previousPage">上一页</button>
    <view class="page-status"><text>{{currentPage}}</text><label>/ {{totalPages}} 页</label></view>
    <button class="page-button" disabled="{{currentPage >= totalPages}}" bindtap="nextPage">下一页</button>
  </view>

  <view class="source-note">题库为考生回忆版，非招录主管部门官方发布。缺失或争议答案不计入训练分。</view>

  <view class="mask" wx:if="{{showModules}}" bindtap="closeModules">
    <view class="sheet" catchtap="stopBubble">
      <view class="sheet-handle"></view>
      <view class="sheet-title">{{selectedPaper.title}}</view>
      <view class="sheet-subtitle">选一个模块单独回归</view>
      <button class="module-row" wx:for="{{selectedPaper.modules}}" wx:key="id" data-module="{{item.id}}" bindtap="startModule">
        <text>{{item.name}}</text><label>{{item.questionCount}} 题 ›</label>
      </button>
      <button class="btn close-btn" bindtap="closeModules">取消</button>
    </view>
  </view>
</view>
