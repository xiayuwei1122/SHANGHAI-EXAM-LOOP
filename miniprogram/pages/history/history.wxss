.history-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.history-title { margin-top: 10rpx; font-family: "Songti SC", serif; font-size: 50rpx; font-weight: 800; }
.history-subtitle { margin-top: 7rpx; color: var(--muted); font-size: 24rpx; }
.record-section-title { display: flex; align-items: center; gap: 14rpx; margin: 34rpx 2rpx 16rpx; font-size: 28rpx; font-weight: 800; }
.record-section-title label { color: var(--muted); font-size: 21rpx; font-weight: 500; }
.completed-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.clear-all { flex: none; min-width: 128rpx; min-height: 58rpx; margin: 0 0 4rpx; padding: 0 18rpx; border: 1rpx solid #d9b8b1; border-radius: 999rpx; color: var(--red); background: #fff7f3; font-size: 22rpx; font-weight: 700; line-height: 58rpx; }
.clear-all::after, .delete-record::after { border: 0; }
.draft-list, .history-list { display: flex; flex-direction: column; gap: 16rpx; }
.draft-card { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; border-color: #b8ccd8; background: #f8fcfe; }
.draft-badge { flex: none; padding: 8rpx 12rpx; border-radius: 999rpx; color: var(--blue); background: #e4f0f5; font-size: 20rpx; font-weight: 800; }
.draft-info { flex: 1; min-width: 0; }
.draft-info text { display: block; overflow: hidden; font-size: 26rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.draft-info label, .draft-info small { display: block; margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }
.draft-info small { color: #7c93a0; }
.draft-action { flex: none; color: var(--blue); font-size: 22rpx; font-weight: 800; }
.history-card { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; }
.score { flex: none; width: 105rpx; color: var(--red); font-family: Georgia, serif; font-size: 46rpx; font-weight: 800; text-align: center; }
.score text { font-size: 19rpx; }
.record-info { flex: 1; min-width: 0; }
.record-info text { display: block; font-size: 26rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.record-info label, .record-info small { display: block; margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }
.record-info small { color: #987940; }
.delete-record { flex: none; min-width: 88rpx; min-height: 56rpx; margin: 0; padding: 0 14rpx; border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--muted); background: transparent; font-size: 21rpx; line-height: 56rpx; }
.empty { margin-top: 35rpx; padding: 60rpx 20rpx; color: var(--muted); text-align: center; }
.completed-empty { padding: 34rpx 20rpx; color: var(--muted); font-size: 23rpx; text-align: center; }
.pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18rpx; margin-top: 26rpx; }
.compact-pagination { margin: 20rpx 0 4rpx; }
.page-button { min-height: 64rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid var(--line); border-radius: 18rpx; color: var(--red-dark); background: #fffaf2; font-size: 23rpx; font-weight: 700; line-height: 64rpx; }
.page-button::after { border: 0; }
.page-button[disabled] { color: #b7aaa0; background: #eee8df; opacity: .7; }
.page-status { min-width: 108rpx; color: var(--muted); text-align: center; }
.page-status text { color: var(--red); font-family: Georgia, serif; font-size: 30rpx; font-weight: 800; }
.page-status label { margin-left: 7rpx; font-size: 21rpx; }
