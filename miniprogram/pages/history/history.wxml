<view class="page history-page">
  <view class="history-heading">
    <view>
      <view class="history-title">练习记录</view>
      <view class="history-subtitle">每一次重刷都保留，不覆盖以前的成绩。</view>
    </view>
  </view>

  <view wx:if="{{drafts.length}}">
    <view class="record-section-title"><text>未完成练习</text><label>{{drafts.length}} 个进度</label></view>
    <view class="draft-list">
      <view class="draft-card card" wx:for="{{drafts}}" wx:key="id" data-id="{{item.id}}" bindtap="continueDraft">
        <view class="draft-badge">进行中</view>
        <view class="draft-info"><text>{{item.paperTitle}}</text><label>{{item.moduleName}} · 已答 {{item.answeredCount}}/{{item.total}}</label><small>{{item.dateText}}</small></view>
        <view class="draft-action">{{item.actionText}} ›</view>
      </view>
    </view>
  </view>

  <view class="completed-heading" wx:if="{{history.length || drafts.length}}">
    <view class="record-section-title"><text>已完成记录</text><label>{{history.length}} 条</label></view>
    <button class="clear-all" wx:if="{{history.length}}" bindtap="clearAllRecords">清空记录</button>
  </view>

  <view class="empty card" wx:if="{{!history.length && !drafts.length}}">还没有练习记录，先去刷一套吧 🌽</view>
  <view class="completed-empty card" wx:if="{{!history.length && drafts.length}}">还没有交卷记录，完成一套后会显示在这里。</view>
  <view class="history-list" wx:if="{{history.length}}">
    <view class="history-card card" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecord">
      <view class="score">{{item.trainingScore}}<text>分</text></view>
      <view class="record-info"><text>{{item.paperTitle}}</text><label>{{item.moduleName}} · {{item.correct}}/{{item.total}} · 用时 {{item.durationText}}</label><small>{{item.dateText}} · 蒙对 {{item.guessedCorrect}}/{{item.guessed}}</small></view>
      <button class="delete-record" data-id="{{item.id}}" catchtap="deleteRecord">删除</button>
    </view>
  </view>
</view>
