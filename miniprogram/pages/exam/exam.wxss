.exam-page { min-height: 100vh; padding: 24rpx 28rpx 150rpx; box-sizing: border-box; }
.exam-top { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.top-title text { display: block; font-size: 31rpx; font-weight: 800; }
.top-title label { display: block; max-width: 420rpx; margin-top: 5rpx; color: var(--muted); font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.timer { flex: none; padding: 12rpx 18rpx; border-radius: 18rpx; background: #332d29; color: white; text-align: right; }
.timer label { display: block; color: #d9cabd; font-size: 18rpx; }
.timer text { display: block; margin-top: 2rpx; font-size: 27rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.progress { height: 10rpx; margin-top: 24rpx; border-radius: 99rpx; overflow: hidden; background: #e5dbcf; }
.progress view { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, var(--gold), var(--red)); }
.progress-meta { display: flex; justify-content: space-between; margin: 12rpx 2rpx 24rpx; color: var(--muted); font-size: 22rpx; }
.material { margin-bottom: 20rpx; padding: 28rpx; font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; }
.material-label { display: inline-flex; margin-bottom: 14rpx; padding: 7rpx 13rpx; border-radius: 10rpx; color: var(--red-dark); background: #f3dfdc; font-size: 22rpx; font-weight: 800; }
.material image { width: 100%; margin-top: 16rpx; }
.question { padding: 30rpx; }
.question-head { display: flex; align-items: center; justify-content: space-between; }
.number { display: grid; place-items: center; width: 62rpx; height: 62rpx; border-radius: 19rpx; background: #332d29; color: white; font-family: Georgia, serif; font-size: 29rpx; font-weight: 800; }
.stem { margin-top: 25rpx; font-size: 30rpx; line-height: 1.75; white-space: pre-wrap; }
.question-image { width: 100%; margin-top: 20rpx; border-radius: 14rpx; }
.options { display: flex; flex-direction: column; gap: 16rpx; margin-top: 30rpx; }
.option { display: flex; align-items: flex-start; gap: 18rpx; padding: 22rpx; border: 2rpx solid var(--line); border-radius: 20rpx; background: white; }
.option.active { border-color: var(--blue); background: #e9f0f4; }
.option-key { display: grid; place-items: center; flex: none; width: 50rpx; height: 50rpx; border-radius: 50%; border: 2rpx solid #cdbfaf; font-weight: 800; }
.option.active .option-key { border-color: var(--blue); background: var(--blue); color: white; }
.option-content { flex: 1; padding-top: 5rpx; font-size: 27rpx; line-height: 1.55; }
.option-content image { width: 100%; margin-top: 10rpx; }
.guess-toggle { display: flex; align-items: center; gap: 15rpx; margin-top: 28rpx; padding: 20rpx; border-radius: 18rpx; background: #f7f1e8; }
.guess-toggle.active { background: #fae8bd; }
.check { display: grid; place-items: center; width: 42rpx; height: 42rpx; border-radius: 12rpx; border: 2rpx solid #b9aa9a; color: white; font-weight: 800; }
.guess-toggle.active .check { border-color: var(--gold); background: var(--gold); }
.guess-toggle text { display: block; font-size: 26rpx; font-weight: 800; }
.guess-toggle label { display: block; margin-top: 3rpx; color: var(--muted); font-size: 21rpx; }
.bottom-actions { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 1.4fr; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255,253,248,.96); }
.mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; background: rgba(31,26,23,.5); }
.sheet { width: 100%; max-height: 78vh; padding: 28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: var(--paper); overflow: auto; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-head text { display: block; font-size: 35rpx; font-weight: 800; }
.sheet-head label { display: block; margin-top: 5rpx; color: var(--muted); font-size: 22rpx; }
.sheet-head button { margin: 0; padding: 0; width: 60rpx; height: 60rpx; line-height: 56rpx; border-radius: 50%; background: #eee6dc; font-size: 36rpx; }
.sheet-head button::after { border: 0; }
.legend { display: flex; gap: 24rpx; margin: 20rpx 0; color: var(--muted); font-size: 21rpx; }
.answer-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 13rpx; }
.cell { position: relative; display: grid; place-items: center; aspect-ratio: 1; border: 1rpx solid #d7ccbf; border-radius: 13rpx; color: #74685e; background: white; font-size: 22rpx; }
.cell.answered { color: white; border-color: var(--blue); background: var(--blue); }
.cell.current { box-shadow: 0 0 0 4rpx rgba(166,65,50,.35); }
.cell.guessed::after { content: ""; position: absolute; right: 5rpx; top: 5rpx; width: 10rpx; height: 10rpx; border-radius: 3rpx; background: var(--gold); transform: rotate(45deg); }
.submit-btn { margin-top: 28rpx; }
