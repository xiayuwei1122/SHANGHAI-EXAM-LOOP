.free-note-page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; background: linear-gradient(180deg, #f5f5ff 0%, #f8f9fd 55%, #f3fbf8 100%); }
.note-meta { display: grid; grid-template-columns: 1fr 180rpx; gap: 14rpx; }
.note-title, .note-category { height: 78rpx; padding: 0 22rpx; box-sizing: border-box; border: 1rpx solid #e1e3f2; border-radius: 20rpx; background: white; box-shadow: 0 8rpx 24rpx rgba(73,73,130,.05); font-size: 25rpx; }
.note-title { color: #292940; font-size: 29rpx; font-weight: 800; }
.note-category { color: #6964e8; text-align: center; }
.editor-controls { position: relative; z-index: 2; }
.toolbar-scroll { display: block; height: 100rpx; margin-top: 18rpx; white-space: nowrap; }
.toolbar { display: inline-flex; align-items: center; gap: 10rpx; min-width: 100%; height: 100rpx; padding: 13rpx; box-sizing: border-box; border: 1rpx solid #e3e4f2; border-radius: 22rpx; background: rgba(255,255,255,.96); box-shadow: 0 10rpx 28rpx rgba(70,70,130,.06); }
.tool, .action-tool { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: none; width: 76rpx; height: 72rpx; border-radius: 15rpx; color: #737386; }
.tool text, .action-tool text { font-size: 28rpx; font-weight: 800; line-height: 1; }
.tool label, .action-tool label { margin-top: 7rpx; font-size: 17rpx; }
.tool.active { color: white; background: linear-gradient(135deg, #6964e8, #8877f2); box-shadow: 0 8rpx 18rpx rgba(105,100,232,.26); }
.action-tool { color: #3976c8; background: #edf5ff; }
.question-tool { width: 92rpx; color: #6a54c7; background: #f0edff; }
.toolbar-divider { flex: none; width: 1rpx; height: 50rpx; margin: 0 2rpx; background: #e4e5ef; }
.history-tool { display: grid; place-items: center; flex: none; width: 60rpx; height: 60rpx; border-radius: 50%; color: #5f5bce; background: #eeedff; font-size: 34rpx; }
.history-tool.disabled { opacity: .28; }
.style-row { display: flex; align-items: center; gap: 14rpx; min-height: 45rpx; margin: 18rpx 4rpx 0; }
.color-dot { width: 34rpx; height: 34rpx; border: 5rpx solid transparent; border-radius: 50%; box-shadow: 0 0 0 1rpx rgba(46,46,76,.14); }
.color-dot.active { border-color: #fff; box-shadow: 0 0 0 3rpx #6964e8; }
.width-options { display: flex; align-items: center; gap: 7rpx; margin-left: auto; padding-left: 13rpx; border-left: 1rpx solid #dde0ed; }
.width-dot { display: grid; place-items: center; width: 45rpx; height: 45rpx; border-radius: 50%; }
.width-dot text { display: block; border-radius: 50%; background: #343449; }
.width-dot.active { background: #e6e5ff; }
.paper-scroll { display: block; height: 58rpx; margin-top: 16rpx; white-space: nowrap; }
.paper-options { display: inline-flex; align-items: center; gap: 10rpx; height: 58rpx; }
.paper-option { padding: 10rpx 18rpx; border: 1rpx solid #dfe1ef; border-radius: 999rpx; color: #767689; background: rgba(255,255,255,.85); font-size: 20rpx; }
.paper-option.active { color: white; border-color: #6964e8; background: #6964e8; box-shadow: 0 6rpx 14rpx rgba(105,100,232,.2); }
.question-importer { position: relative; z-index: 3; margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #dedbff; border-radius: 20rpx; background: #f7f6ff; box-shadow: 0 12rpx 30rpx rgba(78,73,151,.08); }
.question-import-head text, .question-import-head label { display: block; }
.question-import-head text { color: #33324c; font-size: 25rpx; font-weight: 800; }
.question-import-head label { margin-top: 6rpx; color: #85839b; font-size: 19rpx; line-height: 1.5; }
.question-importer textarea { width: 100%; height: 320rpx; margin-top: 16rpx; padding: 18rpx; box-sizing: border-box; border: 1rpx solid #dedff0; border-radius: 16rpx; background: white; font-size: 24rpx; line-height: 1.65; }
.question-images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.question-image, .question-image-add { position: relative; width: 142rpx; height: 142rpx; overflow: hidden; border-radius: 15rpx; }
.question-image image { width: 100%; height: 100%; }
.question-image button { position: absolute; top: 6rpx; right: 6rpx; width: 38rpx; height: 38rpx; margin: 0; padding: 0; border-radius: 50%; color: white; background: rgba(42,42,68,.7); font-size: 27rpx; line-height: 36rpx; }
.question-image button::after { border: 0; }
.question-image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #c9c6ea; color: #77748f; background: white; }
.question-image-add text { font-size: 40rpx; font-weight: 300; }
.question-image-add label { margin-top: 4rpx; font-size: 19rpx; }
.question-import-actions { display: grid; grid-template-columns: 1fr 1.4fr; gap: 12rpx; margin-top: 18rpx; }
.question-import-actions button { min-height: 68rpx; margin: 0; border-radius: 15rpx; background: white; font-size: 22rpx; line-height: 68rpx; }
.question-import-actions button.primary { color: white; background: #6964e8; }
.question-import-actions button::after { border-color: #dedff0; }
.selection-bar { display: flex; align-items: center; gap: 10rpx; margin-top: 16rpx; padding: 12rpx 14rpx; border-radius: 16rpx; background: #e9e8ff; }
.selection-bar text { flex: 1; color: #5550bb; font-size: 19rpx; }
.selection-bar button { min-height: 48rpx; margin: 0; padding: 0 14rpx; border-radius: 12rpx; color: #5550bb; background: white; font-size: 19rpx; line-height: 48rpx; }
.selection-bar button::after { border: 0; }
.selection-bar button.danger { color: #ef4d70; }
.empty-note-state { position: relative; z-index: 2; display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 18rpx 20rpx; border: 1rpx solid #e5e3ff; border-radius: 18rpx; background: #f0efff; }
.empty-note-state view { flex: 1; min-width: 0; }
.empty-note-state text, .empty-note-state label { display: block; }
.empty-note-state text { color: #47439b; font-size: 23rpx; font-weight: 800; }
.empty-note-state label { margin-top: 5rpx; color: #7774a5; font-size: 19rpx; line-height: 1.5; }
.empty-note-state button { flex: none; min-height: 52rpx; margin: 0; padding: 0 16rpx; border-radius: 14rpx; color: #d94f72; background: white; font-size: 19rpx; line-height: 52rpx; }
.empty-note-state button::after { border-color: #efc1ce; }
.canvas-shell { position: relative; z-index: 1; margin-top: 18rpx; overflow: hidden; border: 1rpx solid #e2e3ee; border-radius: 20rpx; background: white; box-shadow: 0 18rpx 44rpx rgba(73,73,130,.1); }
.free-canvas { display: block; width: 100%; height: 1050rpx; }
.canvas-tip { position: absolute; left: 0; right: 0; top: 46%; color: #a9aabd; background: transparent; font-size: 23rpx; text-align: center; pointer-events: none; }
.note-footer { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 17rpx; }
.note-footer text, .note-footer label { display: block; }
.note-footer text { color: #55556d; font-size: 22rpx; font-weight: 700; }
.note-footer label { margin-top: 4rpx; color: #8d8d9f; font-size: 18rpx; }
.clear-button { min-height: 54rpx; margin: 0; padding: 0 16rpx; color: #ef4d70; background: transparent; font-size: 20rpx; line-height: 54rpx; }
.clear-button::after { border-color: #f1b7c5; border-radius: 14rpx; }
.save-note { margin-top: 24rpx; color: white; border-color: #6964e8; background: linear-gradient(135deg, #6964e8, #8877f2); box-shadow: 0 10rpx 24rpx rgba(105,100,232,.2); }
.delete-note { margin-top: 15rpx; color: #ef4d70; background: transparent; font-size: 22rpx; }
.delete-note::after { border: 0; }
@media (min-width: 900px) {
  .free-note-page { max-width: 1100rpx; margin: 0 auto; }
}
