<view class="page editor-page">
  <view class="editor-intro card">
    <view class="intro-title">一张方法卡，记住一个解题方法。</view>
    <view class="intro-note">不用照固定格式，口诀、步骤、易错点或自己的理解，怎么顺手怎么记。</view>
  </view>

  <view class="form-card card">
    <view class="field required"><label>方法标题</label><input value="{{form.title}}" data-field="title" bindinput="inputField" placeholder="例如：两期比重变化判断" maxlength="60" /></view>
    <view class="field"><label>分类</label><input value="{{form.category}}" data-field="category" bindinput="inputField" placeholder="可以输入自己的分类" maxlength="30" /></view>
    <view class="category-presets"><text class="{{form.category === item ? 'active' : ''}}" wx:for="{{categoryPresets}}" wx:key="*this" data-name="{{item}}" bindtap="selectCategory">{{item}}</text></view>
    <view class="field"><label>标签</label><input value="{{form.tagsText}}" data-field="tagsText" bindinput="inputField" placeholder="用逗号分隔，如：公式，易错，秒杀" maxlength="100" /></view>
  </view>

  <view class="form-card card method-content-card">
    <view class="textarea-field method-content"><label>方法内容</label><small>不限格式，按自己的思路自由记录。</small><textarea value="{{form.content}}" data-field="content" bindinput="inputField" placeholder="可以写题目特征、解题步骤、口诀、易错点……\n\n也可以完全按你自己的习惯来。" maxlength="5000" />
    </view>
  </view>

  <view class="section-heading example-section-heading">
    <view><text>典型题</text><label>{{form.examples.length}} 道</label></view>
    <button bindtap="startExternal">＋ 导入外部题</button>
  </view>

  <view class="external-editor card" wx:if="{{showExternalEditor}}">
    <view class="external-title">录入外部典型题</view>
    <view class="textarea-field external-content"><label>题目内容</label><small>题干、选项、答案、解析和来源，想写什么就写什么。</small><textarea value="{{externalForm.content}}" data-field="content" bindinput="inputExternal" placeholder="把题目直接粘贴在这里……\n\n例：\n题目……\n答案：B\n我的理解……" maxlength="5000" /></view>
    <view class="external-images">
      <view class="image-item" wx:for="{{externalForm.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <button data-index="{{index}}" catchtap="removeExternalImage">×</button>
      </view>
      <view class="image-add" wx:if="{{externalForm.images.length < 3}}" bindtap="chooseExternalImages"><text>＋</text><label>题目图片</label></view>
    </view>
    <view class="external-note">文字只需填上面一个大框；也可只添加题目图片。图片保存在本机。</view>
    <view class="external-actions"><button class="btn" bindtap="cancelExternal">取消</button><button class="btn btn-primary" bindtap="addExternalExample">加入典型题</button></view>
  </view>

  <view class="example-card card" wx:for="{{form.examples}}" wx:key="id">
    <view class="example-head"><text>{{item.paperTitle}}{{item.number ? ' · 第 ' + item.number + ' 题' : ''}}</text><button data-index="{{index}}" bindtap="removeExample">移除</button></view>
    <view class="example-type">{{item.moduleName}}{{item.type ? ' · ' + item.type : ''}}</view>
    <view class="example-image-list" wx:if="{{item.images.length}}">
      <image wx:for="{{item.images}}" wx:for-item="image" wx:for-index="imageIndex" wx:key="*this" src="{{image}}" mode="aspectFill" data-example="{{index}}" data-image="{{imageIndex}}" bindtap="previewExampleImage" />
    </view>
    <view class="example-stem" wx:if="{{item.sourceType === 'external' && item.content}}">{{item.content}}</view>
    <view class="example-stem" wx:elif="{{item.stem}}">{{item.stem}}</view>
    <view class="example-answer" wx:if="{{item.sourceType !== 'external'}}">参考答案：{{item.answer || '未填写'}} · 你的答案：{{item.userAnswer || '未答'}}</view>
  </view>

  <view class="section-heading"><text>图片附件</text><label>{{form.images.length}} / 3</label></view>
  <view class="image-card card">
    <view class="image-grid">
      <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage" />
        <button data-index="{{index}}" catchtap="removeImage">×</button>
      </view>
      <view class="image-add" wx:if="{{form.images.length < 3}}" bindtap="chooseImages"><text>＋</text><label>拍照/相册</label></view>
    </view>
    <view class="image-note">第一版先把原图保存在本机；OCR 识别需要联网能力，后续接入。</view>
  </view>

  <button class="btn btn-primary save-button" bindtap="save">保存方法卡</button>
  <button class="delete-method" wx:if="{{isEditing}}" bindtap="remove">删除这张方法卡</button>
</view>
